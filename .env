# ==============================================================================
# CampusCrafters Platform — Root System Environment
# ==============================================================================

# Backend Service
FLASK_APP=backend/run.py
FLASK_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000

# Frontend Service
FRONTEND_PORT=5500
API_BASE_URL=http://localhost:5000/api/v1

# Supabase Database Integration
REPOSITORY_TYPE=database
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Security
SECRET_KEY=campus-crafter-super-secret-key-32-chars-minimum-2026!
JWT_SECRET_KEY=campus-crafter-jwt-secret-key-32-chars-minimum-2026!
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5000,http://127.0.0.1:5000

