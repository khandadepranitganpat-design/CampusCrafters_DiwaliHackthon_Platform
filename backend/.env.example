# ==============================================================================
# CampusCrafters Hackathon Platform — Environment Variables
# ==============================================================================

# Flask Core Environment
FLASK_ENV=development
# Production REFUSES TO START with the sample/default values or secrets shorter than 32 chars.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-campus-crafter-secret-key-2026
JWT_SECRET_KEY=change-me-in-production-campus-crafter-jwt-secret-2026
JWT_EXPIRATION_SECONDS=86400
PORT=5000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# Production Database (Owned by Atharva Kharat — PostgreSQL / Supabase)
# Leave empty in local development to use in-memory repositories.
DATABASE_URL="https://ttdxygzkkzllsfqjkihu.supabase.co"

# Team Configuration (Provisional defaults — awaiting project-lead confirmation)
MIN_TEAM_SIZE=2
MAX_TEAM_SIZE=5

# Submission Deadline (UTC ISO 8601 string, e.g. 2026-11-15T18:30:00Z; empty/omitted = null)
SUBMISSION_DEADLINE_UTC=

# Production Campus Crafter SSO (OAuth 2.0 / OIDC — awaiting project-lead provisioning)
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_DISCOVERY_URL=
SSO_REDIRECT_URI=https://campuscrafters.com/auth/callback
# Cookie SameSite for the SSO flow cookie. Production default is "None" (+Secure) because the
# frontend and API are on different origins; use "Lax" only if they share a site.
SSO_COOKIE_SAMESITE=

# Logging
LOG_LEVEL=DEBUG

